NODE_ENV=development

PORT=3000

CORS_ORIGINS=http://localhost:5173

TRUST_PROXY=loopback, uniquelocal

DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=product_management
DB_LOGGING=false

BCRYPT_ROUNDS=12

# DEV ONLY: change for any other environment (min 32 characters).
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
JWT_ISSUER=product-management-api
JWT_AUDIENCE=product-management-clients
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

THROTTLE_AUTH_TTL_SECONDS=60
THROTTLE_AUTH_LIMIT=10

SEED_ON_STARTUP=true

SEED_SUPER_ADMIN_EMAIL=superadmin@example.com
SEED_SUPER_ADMIN_PASSWORD=SuperAdmin123
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin12345
SEED_USER_EMAIL=user@example.com
SEED_USER_PASSWORD=User12345
SEED_AGENT_EMAIL=agent@example.com
# DEV ONLY: fixed agent key for local development. Change or remove it anywhere else.
SEED_AGENT_API_KEY=pmk_00000000_DEV-ONLY_local-agent-key_CHANGE-ME-outside0
