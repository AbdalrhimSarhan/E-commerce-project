# Environment for the e2e tests (npm run test:e2e). Test-only values, safe to commit.
# The tests use their OWN database (created automatically) on the Docker Postgres.
NODE_ENV=test
PORT=3999
CORS_ORIGINS=
TRUST_PROXY=false

DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=product_management_test
DB_LOGGING=false

# Lowest allowed cost: keeps the suite fast.
BCRYPT_ROUNDS=10

JWT_SECRET=test-only-jwt-secret-0123456789abcdef-xyz
JWT_ISSUER=product-management-api
JWT_AUDIENCE=product-management-clients
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# High limit so the suite never trips it; rate-limit.e2e-spec.ts sets its own.
THROTTLE_AUTH_TTL_SECONDS=60
THROTTLE_AUTH_LIMIT=10000
